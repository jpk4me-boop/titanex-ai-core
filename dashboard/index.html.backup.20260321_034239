<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Titanex AI — Dashboard</title>
<script src="https://cdn.tailwindcss.com"></script>
<script>tailwind.config={theme:{extend:{colors:{brand:{50:'#eef2ff',100:'#e0e7ff',500:'#6366f1',600:'#4f46e5',700:'#4338ca'}}}}}</script>
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,'Inter',sans-serif;background:#f8fafc}.sidebar{scrollbar-width:thin;scrollbar-color:#262626 transparent}
.sidebar{position:fixed;left:0;top:0;height:100vh;width:240px;z-index:40}
.main-content{margin-left:240px;min-height:100vh}
.nav-item{transition:all .15s}
.nav-item:hover{background:#1a1a1a}
.nav-item.active{background:rgba(16,185,129,.1);color:#34d399}
.nav-item.active svg{color:#4f46e5}
.card-hover{transition:all .2s}
.card-hover:hover{transform:translateY(-2px);box-shadow:0 8px 25px -5px rgba(0,0,0,.1)}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.fade-in{animation:fadeIn .4s ease forwards}
.stat-card{transition:all .2s}
.stat-card:hover{transform:translateY(-2px);box-shadow:0 10px 30px -8px rgba(99,102,241,.2)}
@media(max-width:768px){.sidebar{transform:translateX(-100%)}.main-content{margin-left:0}}
</style>
</head>
<body>

<!-- SIDEBAR -->
<aside class="sidebar bg-neutral-950 border-r border-neutral-800 flex flex-col" style="width:240px">
  <div class="px-4 py-5 border-b border-neutral-800">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-600 to-violet-600 flex items-center justify-center text-lg shadow-lg shadow-indigo-500/30">🤖</div>
      <div>
        <div class="font-black text-white text-sm">Titanex <span class="text-emerald-400">AI</span></div>
        <div class="text-xs text-neutral-500 font-medium" id="sb-plan">Plan Pro</div>
      </div>
    </div>
  </div>
  <nav class="flex-1 overflow-y-auto py-3 space-y-0.5 px-2">
    <button onclick="showPage('home')" id="nav-home" class="nav-item active w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-emerald-400 bg-emerald-500/10">
      <i data-lucide="layout-dashboard" class="w-4 h-4"></i> Tableau de bord
    </button>
    <button onclick="showPage('credits')" id="nav-credits" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-neutral-400 hover:text-white hover:bg-neutral-800 transition-all">
      <i data-lucide="zap" class="w-4 h-4"></i>
      <span class="flex-1 text-left">Crédits</span>
      <span id="badge-credits" class="bg-red-500 text-white text-xs font-bold px-2 py-0.5 rounded-full">2539</span>
    </button>
    <button onclick="showPage('paiements')" id="nav-paiements" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-neutral-400 hover:text-white hover:bg-neutral-800 transition-all">
      <i data-lucide="credit-card" class="w-4 h-4"></i> Paiements
    </button>
    <button onclick="showPage('transactions')" id="nav-transactions" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-neutral-400 hover:text-white hover:bg-neutral-800 transition-all">
      <i data-lucide="arrow-left-right" class="w-4 h-4"></i> Mes Transactions
    </button>
    <button onclick="showPage('home')" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-neutral-400 hover:text-white hover:bg-neutral-800 transition-all">
      <i data-lucide="bot" class="w-4 h-4"></i> Agents IA
    </button>
    <button onclick="location.href='/dashboard/qr-connect.html'" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-emerald-500 hover:text-emerald-400 hover:bg-emerald-500/10 transition-all">
      <i data-lucide="plug" class="w-4 h-4"></i> Connexions
    </button>
    <div class="h-px bg-neutral-800 my-2 mx-1"></div>
    <button onclick="showPage('catalogue')" id="nav-catalogue" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-neutral-400 hover:text-white hover:bg-neutral-800 transition-all">
      <i data-lucide="package" class="w-4 h-4"></i> Produits et services
    </button>
    <button onclick="showPage('catalogue')" class="nav-item w-full flex items-center gap-3 pl-8 pr-3 py-2 rounded-xl text-xs font-medium text-neutral-500 hover:text-white hover:bg-neutral-800 transition-all">
      <i data-lucide="layers" class="w-3.5 h-3.5"></i> Catégories/Statuts
    </button>
    <button onclick="showPage('home')" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-neutral-400 hover:text-white hover:bg-neutral-800 transition-all">
      <i data-lucide="book-open" class="w-4 h-4"></i> Base de connaissances
    </button>
    <button onclick="showPage('home')" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-neutral-400 hover:text-white hover:bg-neutral-800 transition-all">
      <i data-lucide="shopping-cart" class="w-4 h-4"></i> Commandes
    </button>
    <button onclick="showPage('clients')" id="nav-clients" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-neutral-400 hover:text-white hover:bg-neutral-800 transition-all">
      <i data-lucide="user-check" class="w-4 h-4"></i> Leads
    </button>
    <button onclick="showPage('conversations')" id="nav-conversations" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-neutral-400 hover:text-white hover:bg-neutral-800 transition-all">
      <i data-lucide="message-square" class="w-4 h-4"></i>
      <span class="flex-1 text-left">Conversations</span>
      <span id="badge-conv" class="bg-indigo-600 text-white text-xs font-bold px-2 py-0.5 rounded-full hidden">0</span>
    </button>
    <button onclick="showPage('home')" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-neutral-400 hover:text-white hover:bg-neutral-800 transition-all">
      <i data-lucide="puzzle" class="w-4 h-4"></i> Widgets
    </button>
    <button onclick="showPage('home')" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-neutral-400 hover:text-white hover:bg-neutral-800 transition-all">
      <i data-lucide="calendar" class="w-4 h-4"></i> Calendrier
    </button>
    <button onclick="showPage('home')" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-neutral-400 hover:text-white hover:bg-neutral-800 transition-all">
      <i data-lucide="crown" class="w-4 h-4"></i> Ambassadeurs
    </button>
    <div class="h-px bg-neutral-800 my-2 mx-1"></div>
    <button onclick="showPage('settings')" id="nav-settings" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-neutral-400 hover:text-white hover:bg-neutral-800 transition-all">
      <i data-lucide="settings" class="w-4 h-4"></i> Paramètres
    </button>
    <button onclick="showPage('home')" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-neutral-400 hover:text-white hover:bg-neutral-800 transition-all">
      <i data-lucide="globe" class="w-4 h-4"></i> Domaine perso
    </button>
    <button onclick="showPage('home')" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-neutral-400 hover:text-white hover:bg-neutral-800 transition-all">
      <i data-lucide="graduation-cap" class="w-4 h-4"></i> Academy
    </button>
    <button onclick="location.href='/dashboard/admin/'" class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-neutral-400 hover:text-white hover:bg-neutral-800 transition-all">
      <i data-lucide="shield" class="w-4 h-4"></i> Command Center
    </button>
  </nav>
  <div class="border-t border-neutral-800 px-2 py-3 space-y-0.5">
    <button onclick="navigator.clipboard&&navigator.clipboard.writeText(window.location.href)" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-neutral-400 hover:text-white hover:bg-neutral-800 transition-all">
      <i data-lucide="copy" class="w-4 h-4"></i>
      <span class="flex-1 text-left">Copier le lien</span>
      <i data-lucide="share-2" class="w-3.5 h-3.5 text-neutral-600"></i>
    </button>
    <button id="dark-toggle" onclick="toggleTheme()" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-neutral-400 hover:text-white hover:bg-neutral-800 transition-all">
      <i data-lucide="sun" class="w-4 h-4"></i> Mode Clair
    </button>
    <button onclick="logout()" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-neutral-400 hover:text-red-400 hover:bg-red-500/10 transition-all">
      <i data-lucide="log-out" class="w-4 h-4"></i> Déconnexion
    </button>
    <div class="flex items-center gap-3 px-3 py-2.5 rounded-xl bg-neutral-900 mt-2">
      <div class="w-7 h-7 rounded-full bg-indigo-600 flex items-center justify-center text-white text-xs font-black flex-shrink-0" id="sb-av">S</div>
      <div class="flex-1 min-w-0">
        <div class="text-xs font-bold text-white truncate" id="sb-name">Mon compte</div>
        <div class="text-xs text-neutral-500 truncate" id="sb-instance">—</div>
      </div>
    </div>
  </div>
</aside>

<!-- MAIN -->
<div class="main-content">

  <!-- TOP BAR -->
  <header class="sticky top-0 z-30 bg-white/80 backdrop-blur border-b border-slate-200 px-8 py-4 flex items-center justify-between">
    <div>
      <h1 class="text-lg font-black text-slate-900" id="page-title">Vue d'ensemble</h1>
      <p class="text-xs text-slate-500" id="page-sub">Bonjour ! Voici l'activité de votre agent.</p>
    </div>
    <div class="flex items-center gap-3">
      <div id="agent-status" class="flex items-center gap-2 bg-emerald-50 border border-emerald-200 text-emerald-700 px-3 py-1.5 rounded-full text-xs font-semibold">
        <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span>
        Agent actif
      </div>
      <button onclick="showPage('settings')" class="w-9 h-9 rounded-xl bg-slate-100 hover:bg-slate-200 flex items-center justify-center transition-colors">
        <i data-lucide="settings" class="w-4 h-4 text-slate-500"></i>
      </button>
    </div>
  </header>

  <!-- PAGES -->
  <div class="p-8">

    <!-- HOME -->
    <div id="pg-home" class="fade-in space-y-6">

  <!-- Header topbar info -->
  <div class="flex items-center justify-between -mt-2 mb-2">
    <div>
      <h2 class="text-2xl font-black text-white">Ravi de vous retrouver <span class="text-emerald-400" id="hello-name">Jean</span>, 👋</h2>
      <p class="text-sm text-neutral-500 mt-1">qu'est-ce que nous créons aujourd'hui ?</p>
    </div>
    <div class="flex items-center gap-3">
      <div class="flex items-center gap-2 bg-neutral-900 border border-neutral-700 px-3 py-2 rounded-xl">
        <i data-lucide="user" class="w-4 h-4 text-neutral-400"></i>
        <span class="text-sm font-semibold text-white" id="topbar-name">Sango Montana</span>
      </div>
      <div class="flex items-center gap-2 bg-emerald-500/10 border border-emerald-500/30 px-3 py-2 rounded-xl">
        <i data-lucide="zap" class="w-4 h-4 text-emerald-400"></i>
        <span class="text-sm font-bold text-emerald-400" id="topbar-credits">2539 crédits</span>
        <i data-lucide="info" class="w-3.5 h-3.5 text-emerald-600"></i>
      </div>
      <button class="w-9 h-9 rounded-xl bg-neutral-900 border border-neutral-700 flex items-center justify-center text-neutral-400 hover:text-white transition-colors relative">
        <i data-lucide="bell" class="w-4 h-4"></i>
        <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-emerald-500 rounded-full border border-neutral-900"></span>
      </button>
    </div>
  </div>

  <!-- Agent cards -->
  <div class="grid grid-cols-3 gap-4">
    <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-5 hover:border-neutral-700 transition-all">
      <div class="flex items-center gap-2 mb-4">
        <i data-lucide="bar-chart-2" class="w-4 h-4 text-emerald-400"></i>
        <span class="text-sm font-semibold text-neutral-300">Total des agents</span>
      </div>
      <div class="text-5xl font-black text-white mb-3">1</div>
      <div class="flex items-center gap-2 text-xs text-neutral-500">
        <i data-lucide="circle-dot" class="w-3 h-3 text-emerald-500"></i> En ligne : 1
      </div>
    </div>
    <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-5 hover:border-neutral-700 transition-all">
      <div class="flex items-center gap-2 mb-4">
        <i data-lucide="star" class="w-4 h-4 text-emerald-400"></i>
        <span class="text-sm font-semibold text-neutral-300">Agent le plus récent</span>
      </div>
      <div class="text-lg font-black text-white mb-1" id="agent-name-card">Sango Montana</div>
      <div class="text-xs text-neutral-500 mb-3" id="agent-date-card">7 mars 2026</div>
      <span class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-full border border-emerald-500/20">
        <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span> En ligne
      </span>
    </div>
    <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-5 hover:border-neutral-700 transition-all">
      <div class="flex items-center gap-2 mb-4">
        <i data-lucide="clock" class="w-4 h-4 text-neutral-500"></i>
        <span class="text-sm font-semibold text-neutral-300">Second plus récent</span>
      </div>
      <div class="text-2xl font-black text-neutral-600 mb-1">—</div>
      <div class="text-xs text-neutral-600">Aucun agent supplémentaire</div>
    </div>
  </div>

  <!-- Analyse des leads -->
  <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-6">
    <div class="flex items-center justify-between mb-5">
      <h3 class="text-base font-bold text-white">Analyse des leads</h3>
      <div class="flex gap-2">
        <button class="px-3 py-1.5 rounded-lg bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 text-xs font-semibold">7 derniers jours ▾</button>
        <button class="px-3 py-1.5 rounded-lg bg-neutral-800 text-neutral-400 text-xs font-medium hover:text-white transition-colors">30 derniers jours ▾</button>
        <button class="px-3 py-1.5 rounded-lg bg-neutral-800 text-neutral-400 text-xs font-medium hover:text-white transition-colors">90 derniers jours ▾</button>
        <button class="px-3 py-1.5 rounded-lg bg-neutral-800 text-neutral-400 text-xs font-medium hover:text-white transition-colors">Tous les agents ▾</button>
      </div>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div class="bg-neutral-800/50 rounded-xl p-5">
        <div class="flex items-center gap-2 mb-3">
          <i data-lucide="users" class="w-4 h-4 text-neutral-400"></i>
          <span class="text-sm font-semibold text-neutral-300">Nombre total de leads</span>
        </div>
        <div class="text-5xl font-black text-white mb-2" id="leads-total">8</div>
        <div class="flex items-center gap-1.5 text-xs text-red-400">
          <i data-lucide="trending-up" class="w-3.5 h-3.5"></i> Croissance : -100.00%
        </div>
      </div>
      <div class="bg-neutral-800/50 rounded-xl p-5">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <i data-lucide="trending-up" class="w-4 h-4 text-neutral-400"></i>
            <span class="text-sm font-semibold text-neutral-300">Leads générés</span>
          </div>
          <a href="#" class="text-xs text-emerald-400 hover:underline font-semibold flex items-center gap-1">Voir tous les leads <i data-lucide="arrow-up-right" class="w-3 h-3"></i></a>
        </div>
        <div class="text-5xl font-black text-white mb-2">0</div>
        <div class="flex items-center gap-1.5 text-xs text-red-400">
          <i data-lucide="trending-up" class="w-3.5 h-3.5"></i> -100.00%
        </div>
        <div class="text-xs text-neutral-600 mt-1">7 derniers jours</div>
      </div>
    </div>
  </div>

  <!-- Credits + Parrainage -->
  <div class="grid grid-cols-2 gap-4">
    <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-6">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-2">
          <i data-lucide="zap" class="w-4 h-4 text-emerald-400"></i>
          <span class="text-sm font-bold text-white">Crédits disponibles</span>
        </div>
        <span class="text-xs text-emerald-400 font-bold">100%</span>
      </div>
      <div class="flex items-baseline gap-2 mb-3">
        <span class="text-4xl font-black text-white" id="credits-val">2539</span>
        <span class="text-neutral-500 text-sm">/2550</span>
      </div>
      <div class="w-full bg-neutral-800 rounded-full h-2 mb-4">
        <div class="bg-emerald-500 h-2 rounded-full transition-all" id="credits-bar" style="width:99.6%"></div>
      </div>
      <button onclick="location.href='/dashboard/paiement.html'" class="w-full flex items-center justify-center gap-2 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-black font-black text-sm transition-all hover:-translate-y-0.5 shadow-lg shadow-emerald-500/25">
        <i data-lucide="zap" class="w-4 h-4"></i> Recharger
      </button>
    </div>
    <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-6">
      <div class="flex items-center gap-2 mb-4">
        <i data-lucide="gift" class="w-4 h-4 text-emerald-400"></i>
        <span class="text-sm font-bold text-white">Programme de Parrainage</span>
      </div>
      <div class="flex items-baseline gap-2 mb-1">
        <span class="text-4xl font-black text-white">2550</span>
        <span class="text-neutral-500 text-sm">points cumulés</span>
      </div>
      <p class="text-xs text-neutral-500 mb-4">Partagez votre lien et gagnez des crédits !</p>
      <div class="flex items-center gap-2 bg-neutral-800 rounded-xl px-3 py-2.5 border border-neutral-700">
        <i data-lucide="link" class="w-3.5 h-3.5 text-neutral-500 flex-shrink-0"></i>
        <span class="text-xs text-neutral-400 flex-1 truncate" id="ref-link">https://titanexai.com/ref/...</span>
        <button onclick="navigator.clipboard&&navigator.clipboard.writeText(document.getElementById('ref-link').textContent)" class="text-neutral-400 hover:text-emerald-400 transition-colors flex-shrink-0">
          <i data-lucide="copy" class="w-3.5 h-3.5"></i>
        </button>
      </div>
    </div>
  </div>

  <!-- Dernières actions agent -->
  <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-6">
    <div class="flex items-center gap-2 mb-5">
      <i data-lucide="clock" class="w-4 h-4 text-amber-400"></i>
      <h3 class="text-base font-bold text-white">Dernières Actions de l'Agent</h3>
    </div>
    <div id="agent-actions" class="space-y-1">
      <div class="flex items-center gap-3 px-3 py-3 rounded-xl hover:bg-neutral-800 transition-colors">
        <div class="w-6 h-6 rounded-full bg-amber-500/20 flex items-center justify-center flex-shrink-0"><i data-lucide="clock" class="w-3 h-3 text-amber-400"></i></div>
        <span class="text-sm text-neutral-300 flex-1">Relance envoyée à Client</span>
        <span class="text-xs font-bold text-emerald-400">200 000 XAF</span>
        <span class="text-xs text-neutral-600 w-10 text-right">00:11</span>
      </div>
      <div class="flex items-center gap-3 px-3 py-3 rounded-xl hover:bg-neutral-800 transition-colors">
        <div class="w-6 h-6 rounded-full bg-amber-500/20 flex items-center justify-center flex-shrink-0"><i data-lucide="clock" class="w-3 h-3 text-amber-400"></i></div>
        <span class="text-sm text-neutral-300 flex-1">Relance envoyée à Client</span>
        <span class="text-xs text-neutral-600 w-10 text-right">00:04</span>
      </div>
      <div class="flex items-center gap-3 px-3 py-3 rounded-xl hover:bg-neutral-800 transition-colors" id="recent-convs-actions">
        <div class="w-6 h-6 rounded-full bg-emerald-500/20 flex items-center justify-center flex-shrink-0"><i data-lucide="check-circle" class="w-3 h-3 text-emerald-400"></i></div>
        <span class="text-sm text-neutral-300 flex-1">Vente réussie (Écouteurs Bluetooth Pro) à Jean Test</span>
        <span class="text-xs font-bold text-emerald-400">15 000 XAF</span>
        <span class="text-xs text-neutral-600 w-10 text-right">02:15</span>
      </div>
      <div class="flex items-center gap-3 px-3 py-3 rounded-xl hover:bg-neutral-800 transition-colors">
        <div class="w-6 h-6 rounded-full bg-blue-500/20 flex items-center justify-center flex-shrink-0"><i data-lucide="credit-card" class="w-3 h-3 text-blue-400"></i></div>
        <span class="text-sm text-neutral-300 flex-1">Lien de paiement généré pour Client Test Turbo</span>
        <span class="text-xs font-bold text-blue-400">15 000 XAF</span>
        <span class="text-xs text-neutral-600 w-10 text-right">09:59</span>
      </div>
    </div>
  </div>

  <!-- Avis Clients -->
  <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-6">
    <div class="flex items-center justify-between mb-5">
      <div class="flex items-center gap-2">
        <i data-lucide="star" class="w-4 h-4 text-yellow-400"></i>
        <h3 class="text-base font-bold text-white">Avis Clients</h3>
      </div>
      <div class="flex items-center gap-1.5">
