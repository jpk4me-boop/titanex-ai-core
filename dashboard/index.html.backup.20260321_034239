function loadConvs(){
  if(!SESSION)return;
  fetch('/admin/conversations?limit=50&instance='+SESSION.instance_name)
    .then(function(r){return r.json();})
    .then(function(d){ALL_CONVS=Array.isArray(d)?d:[];renderConvs(ALL_CONVS);})
