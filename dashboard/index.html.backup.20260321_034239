function renderConvs(data){
  var el=document.getElementById('convs-list');if(!el)return;
  var cnt=document.getElementById('conv-count-all');
  var lbl=document.getElementById('conv-count-label');
  if(cnt)cnt.textContent=data.length;
  if(lbl)lbl.textContent=data.length+' contacts sur '+ALL_CONVS.length;
  if(!data.length){el.innerHTML='<div class="flex flex-col items-center justify-center h-full py-8 text-center"><p class="text-sm text-neutral-500">Aucune conversation pour le moment.</p></div>';return;}
  el.innerHTML=data.map(function(conv,i){
    var ini=initials(conv.from||'WA');
    var cols=['bg-indigo-600','bg-emerald-600','bg-amber-600','bg-purple-600','bg-blue-600'];
    var col=cols[ini.charCodeAt(0)%cols.length];
    return '<div class="flex items-center gap-3 px-4 py-3 hover:bg-neutral-800 cursor-pointer border-b border-neutral-800 transition-colors" onclick="showConvDetail('+i+')">'
      +'<div class="w-9 h-9 rounded-full '+col+' flex items-center justify-center text-white text-xs font-bold flex-shrink-0">'+ini+'</div>'
      +'<div class="flex-1 min-w-0"><div class="flex items-center justify-between mb-0.5"><span class="text-sm font-semibold text-white truncate">'+(conv.from||'Inconnu')+'</span><span class="text-xs text-neutral-500 ml-2">'+fmtDate(conv.created_at)+'</span></div>'
      +'<p class="text-xs text-neutral-500 truncate">'+(conv.user_message||'—')+'</p></div></div>';
  }).join('');
}
