}
function insertTemplate(type){
  var ta=document.getElementById('prompt-editor');
  if(!ta)return;
  var tpl=PROMPT_TEMPLATES[type]||'';
  if(SESSION){tpl=tpl.replace(/\[NOM\]/g,SESSION.nom||'Agent').replace(/\[BOUTIQUE\]/g,SESSION.instance_name||'Boutique').replace(/\[SERVICE\]/g,SESSION.instance_name||'Service');}
  ta.value=tpl;
  updatePromptChars();
}
function savePrompt(){
  var ta=document.getElementById('prompt-editor');
  if(!ta||!ta.value.trim()){alert('Le prompt est vide.');return;}
  var btn=document.querySelector('[onclick=\"savePrompt()\"]');
  if(btn){btn.textContent='Sauvegarde...';btn.disabled=true;}
  setTimeout(function(){
    if(btn){btn.innerHTML='<i data-lucide=\"check\" class=\"w-4 h-4\"></i> Sauvegardé !';lucide.createIcons();}
    setTimeout(function(){
      if(btn){btn.innerHTML='<i data-lucide=\"save\" class=\"w-4 h-4\"></i> Sauvegarder';btn.disabled=false;lucide.createIcons();}
    },2000);
  },800);
}
